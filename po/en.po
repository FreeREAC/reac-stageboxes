#: src/rs-pw.c:258
msgid "Could not create a PipeWire loop."
msgstr "Could not create a PipeWire loop."

#: src/rs-pw.c:268
msgid "Could not create a PipeWire context."
msgstr "Could not create a PipeWire context."

#: src/rs-pw.c:278
msgid "Could not connect to PipeWire. Is the session running?"
msgstr "Could not connect to PipeWire. Is the session running?"

#: src/rs-pw.c:287
msgid "Could not read the PipeWire registry."
msgstr "Could not read the PipeWire registry."

#: src/rs-pw.c:316
msgid "That stagebox has left the graph."
msgstr "That stagebox has left the graph."

#: src/rs-pw.c:321
msgid "This segment has no control door: another master owns it."
msgstr "This segment has no control door: another master owns it."

#: src/rs-pw.c:330
msgid "No wire address for this input: the box has announced no base."
msgstr "No wire address for this input: the box has announced no base."

#: src/rs-pw.c:339
msgid "That value is outside what the daemon accepts."
msgstr "That value is outside what the daemon accepts."

#: src/rs-window.c:82
msgid "Another master owns this segment, so there is no preamp control here."
msgstr "Another master owns this segment, so there is no preamp control here."

#: src/rs-window.c:84
msgid ""
"This box is strapped to REAC master mode. Its preamps are set on the box "
"itself, over its serial port — REAC carries no preamp control to a box in "
"master mode."
msgstr "This box is strapped to REAC master mode. Its preamps are set on the box itself, over its serial port — REAC carries no preamp control to a box in master mode."

#: src/rs-window.c:86
msgid "No stagebox recognised on this segment yet."
msgstr "No stagebox recognised on this segment yet."

#: src/rs-window.c:88
msgid ""
"The box has announced no head-amp base, so its inputs have no wire address."
msgstr "The box has announced no head-amp base, so its inputs have no wire address."

#: src/rs-window.c:90
msgid "The link to this box is not established."
msgstr "The link to this box is not established."

#: src/rs-window.c:92
msgid ""
"No readback from this daemon: it publishes no head-amp state, so a change "
"could not be confirmed. Shown read-only."
msgstr "No readback from this daemon: it publishes no head-amp state, so a change could not be confirmed. Shown read-only."

#: src/rs-window.c:105
msgid "Refused: the box is in master mode."
msgstr "Refused: the box is in master mode."

#: src/rs-window.c:107
msgid "Refused: no box on this segment."
msgstr "Refused: no box on this segment."

#: src/rs-window.c:109
msgid "Refused: no wire address for this box."
msgstr "Refused: no wire address for this box."

#: src/rs-window.c:111
msgid "Refused: the daemon did not recognise that control."
msgstr "Refused: the daemon did not recognise that control."

#: src/rs-window.c:113
msgid "Refused: that value is out of range."
msgstr "Refused: that value is out of range."

