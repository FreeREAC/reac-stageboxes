#
# The catalogues. Source strings are English; `en` is shipped as a real
# catalogue rather than left implicit so an English session and a Catalan one
# go down the same path and a broken build shows up in both.
i18n = import('i18n')
i18n.gettext(gettext_package, preset : 'glib')
