#: src/rs-box.c:258
msgid "fw"
msgstr "microprog."

#: src/rs-box.c:260
msgid "REAC"
msgstr "REAC"

#: src/rs-box.c:275
msgid "Another master owns this segment, so there is no preamp control here."
msgstr "Aquest segment el governa un altre mestre; aquí no hi ha control de previs."

#: src/rs-box.c:277
msgid ""
"This box is strapped to REAC master mode. Its preamps are set on the box "
"itself, over its serial port — REAC carries no preamp control to a box in "
"master mode."
msgstr "Aquesta caixa està configurada en mode mestre REAC. Els seus previs es configuren a la caixa mateixa, pel port sèrie: REAC no transporta cap control de previ cap a una caixa en mode mestre."

#: src/rs-box.c:279
msgid "No stagebox recognised on this segment yet."
msgstr "Encara no s'ha reconegut cap caixa d'escenari en aquest segment."

#: src/rs-box.c:281
msgid ""
"The box has announced no head-amp base, so its inputs have no wire address."
msgstr "La caixa no ha anunciat cap base de previs, de manera que les seves entrades no tenen adreça de cable."

#: src/rs-box.c:283
msgid "The link to this box is not established."
msgstr "L'enllaç amb aquesta caixa no està establert."

#: src/rs-box.c:285
msgid ""
"No readback from this daemon: it publishes no head-amp state, so a change "
"could not be confirmed. Shown read-only."
msgstr "Aquest dimoni no retorna cap lectura: no publica l'estat dels previs, de manera que no es podria confirmar cap canvi. Es mostra només de lectura."

#: src/rs-box.c:295
msgid "Refused: the box is in master mode."
msgstr "Refusat: la caixa és en mode mestre."

#: src/rs-box.c:297
msgid "Refused: no box on this segment."
msgstr "Refusat: no hi ha cap caixa en aquest segment."

#: src/rs-box.c:299
msgid "Refused: no wire address for this box."
msgstr "Refusat: aquesta caixa no té adreça de cable."

#: src/rs-box.c:301
msgid "Refused: the daemon did not recognise that control."
msgstr "Refusat: el dimoni no ha reconegut aquest control."

#: src/rs-box.c:303
msgid "Refused: that value is out of range."
msgstr "Refusat: aquest valor és fora d'interval."

#: src/rs-box.c:304
#, c-format
msgid "Refused by the daemon: %s"
msgstr "Refusat pel dimoni: %s"

#: src/rs-list.c:26
msgid "on"
msgstr "sí"

#: src/rs-list.c:26
msgid "off"
msgstr "no"

#: src/rs-list.c:33
msgid "(unanswered)"
msgstr "(sense resposta)"

#: src/rs-list.c:40
#, c-format
msgid "segment %s — %s %s, link %s, door %s\n"
msgstr "segment %s — %s %s, enllaç %s, porta %s\n"

#: src/rs-list.c:43
msgid "sink"
msgstr "reproducció"

#: src/rs-list.c:43
msgid "source"
msgstr "captura"

#: src/rs-list.c:46
#, c-format
msgid "  base %d · %d inputs · caps %s · sensitivity max %d%s\n"
msgstr "  base %d · %d entrades · capacitats %s · sensibilitat màx. %d%s\n"

#: src/rs-list.c:48 src/rs-list.c:54
msgid "(none)"
msgstr "(cap)"

#: src/rs-list.c:50
msgid " (assumed)"
msgstr " (suposada)"

#: src/rs-list.c:52
#, c-format
msgid "  no base · %d inputs · caps %s\n"
msgstr "  sense base · %d entrades · capacitats %s\n"

#: src/rs-list.c:56
#, c-format
msgid ""
"  mac %s · firmware %s · REAC %s · master %s · refused %s · readback %s\n"
msgstr "  mac %s · microprogramari %s · REAC %s · mestre %s · refusat %s · lectura %s\n"

#: src/rs-list.c:61
msgid "(not published)"
msgstr "(no publicat)"

#: src/rs-list.c:62
msgid "yes"
msgstr "sí"

#: src/rs-list.c:62
msgid "no"
msgstr "no"

#: src/rs-list.c:69
#, c-format
msgid "  status: %s [%s]\n"
msgstr "  estat: %s [%s]\n"

#: src/rs-list.c:71
#, c-format
msgid "  status: preamps ready [%s]\n"
msgstr "  estat: previs a punt [%s]\n"

#: src/rs-list.c:84
#, c-format
msgid "%d (%d dBu)"
msgstr "%d (%d dBu)"

#: src/rs-list.c:88
#, c-format
msgid ""
"    input %2d  wire channel %3d  phantom %-4s  pad %-4s  sensitivity %s\n"
msgstr "    entrada %2d  canal de cable %3d  fantasma %-4s  atenuador %-4s  sensibilitat %s\n"

#: src/rs-list.c:119
msgid "Could not connect to PipeWire."
msgstr "No s'ha pogut connectar amb PipeWire."

#: src/rs-list.c:135
#, c-format
msgid "%u node bound"
msgid_plural "%u nodes bound"
msgstr[0] "%u node vinculat"
msgstr[1] "%u nodes vinculats"

#: src/rs-list.c:138
#, c-format
msgid "No REAC segments found (%s).\n"
msgstr "No s'ha trobat cap segment REAC (%s).\n"

#: src/rs-list.c:145
#, c-format
msgid "%u REAC segment"
msgid_plural "%u REAC segments"
msgstr[0] "%u segment REAC"
msgstr[1] "%u segments REAC"

#: src/rs-list.c:147
#, c-format
msgid ""
"%s (%s).\n"
"\n"
msgstr "%s (%s).\n\n"

#: src/rs-pw.c:289
msgid "Could not create a PipeWire loop."
msgstr "No s'ha pogut crear el bucle de PipeWire."

#: src/rs-pw.c:299
msgid "Could not create a PipeWire context."
msgstr "No s'ha pogut crear el context de PipeWire."

#: src/rs-pw.c:309
msgid "Could not connect to PipeWire. Is the session running?"
msgstr "No s'ha pogut connectar amb PipeWire. Segur que la sessió s'està executant?"

#: src/rs-pw.c:318
msgid "Could not read the PipeWire registry."
msgstr "No s'ha pogut llegir el registre de PipeWire."

#: src/rs-pw.c:362
msgid "That stagebox has left the graph."
msgstr "Aquesta caixa d'escenari ja no és al graf."

#: src/rs-pw.c:367
msgid "This segment has no control door: another master owns it."
msgstr "Aquest segment no té porta de control: el governa un altre mestre."

#: src/rs-pw.c:376
msgid "No wire address for this input: the box has announced no base."
msgstr "Aquesta entrada no té adreça de cable: la caixa no ha anunciat cap base."

#: src/rs-pw.c:385
msgid "That value is outside what the daemon accepts."
msgstr "Aquest valor és fora del que accepta el dimoni."

#: src/rs-window.c:96
msgid "Writing…"
msgstr "S'està escrivint…"

#: src/rs-window.c:139
#, c-format
msgid "%d dBu"
msgstr "%d dBu"

#: src/rs-window.c:162
#, c-format
msgid "Input %d"
msgstr "Entrada %d"

#: src/rs-window.c:183
msgid "Phantom power (+48 V)"
msgstr "Alimentació fantasma (+48 V)"

#: src/rs-window.c:192
msgid "Pad (−20 dB)"
msgstr "Atenuador (−20 dB)"

#: src/rs-window.c:201
msgid "Sensitivity"
msgstr "Sensibilitat"

#: src/rs-window.c:243
#, c-format
msgid "wire channel %d"
msgstr "canal de cable %d"

#: src/rs-window.c:278
msgid "No readback from this daemon."
msgstr "Aquest dimoni no retorna cap lectura."

#: src/rs-window.c:280
msgid "Nothing asserted for this input yet."
msgstr "Encara no s'ha fixat res per a aquesta entrada."

#: src/rs-window.c:291 src/rs-window.c:446 src/rs-window.c:502
